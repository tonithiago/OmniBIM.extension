<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework Condition="'$(TargetFramework)' == ''">net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RevitVersion Condition="'$(RevitVersion)' == ''">2025</RevitVersion>
    <RevitPath Condition="'$(RevitPath)' == ''">C:\Program Files\Autodesk\Revit $(RevitVersion)</RevitPath>
    <AssemblyName>TOPOBIM</AssemblyName>
    <OutputPath>bin\$(RevitVersion)\$(Configuration)\</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="RevitAPI"><HintPath>$(RevitPath)\RevitAPI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="RevitAPIUI"><HintPath>$(RevitPath)\RevitAPIUI.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <Target Name="CheckRevit" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(RevitPath)\RevitAPI.dll')" Text="RevitAPI.dll não encontrada. Instale Revit $(RevitVersion) ou informe -p:RevitPath=..." />
  </Target>
</Project>
