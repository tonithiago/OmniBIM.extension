 </StackPanel></Border><Border Style="{StaticResource Card}" Padding="18"><StackPanel><TextBlock Text="CAMADAS DE ORIGEM" FontSize="10" FontWeight="SemiBold" Foreground="#777777"/><TextBlock Text="Coordenadas do DWG" Style="{StaticResource Label}"/><ComboBox x:Name="CadCoordinates" SelectedIndex="0" SelectionChanged="CadCoordinatesChanged"><ComboBoxItem Content="Originais do levantamento (WCS)"/><ComboBoxItem Content="Posição atual / compartilhadas do Revit"/></ComboBox><ListBox x:Name="Layers" SelectionMode="Multiple" Height="170" BorderBrush="#DADADA" BorderThickness="1" Margin="0,10,0,8" SelectionChanged="LayerChanged" ScrollViewer.VerticalScrollBarVisibility="Auto"><ListBox.ItemTemplate><DataTemplate><CheckBox Content="{Binding}" IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Mode=TwoWay}" Margin="0,2"/></DataTemplate></ListBox.ItemTemplate></ListBox><Button Content="Aplicar camadas selecionadas" Click="ApplyLayers" HorizontalAlignment="Left" Padding="12,8" Margin="0,0,0,4"/><TextBlock Text="DWG: marque a layer do levantamento e clique em Aplicar camadas selecionadas. Você pode marcar mais de uma. CSV: todas as coordenadas lidas." TextWrapping="Wrap" FontSize="10" Foreground="#777777" Margin="0,7,0,0"/></StackPanel></Border></StackPanel>
