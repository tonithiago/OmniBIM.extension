<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Localizar/Substituir" 
        Height="650" Width="823"
        MinHeight="500" MinWidth="800"
        WindowStartupLocation="CenterScreen" Background="#F2F3F5" FontFamily="Segoe UI">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TOPO: Entradas de Texto (Localizar e Substituir) -->
        <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="5,0">
                    <TextBlock Text="LOCALIZAR" FontSize="11" FontWeight="Bold" Foreground="#999" Margin="0,0,0,5"/>
                    <TextBox x:Name="tbFind" Height="32" Padding="5,5,5,5" VerticalContentAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="5,0">
                    <TextBlock Text="SUBSTITUIR" FontSize="11" FontWeight="Bold" Foreground="#999" Margin="0,0,0,5"/>
                    <TextBox x:Name="tbReplace" Height="32" Padding="5,5,5,5" VerticalContentAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MEIO: Seleção e Pré-visualização -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="4*"/>
                <ColumnDefinition Width="6*"/>
            </Grid.ColumnDefinitions>

            <!-- COLUNA ESQUERDA: Selecionar Vistas -->
            <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="15" Margin="0,0,7,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="1. SELECIONAR VISTAS" FontWeight="Bold" FontSize="12" Margin="0,0,0,15" Foreground="#333"/>

                    <!-- COMBOBOX COM AS NOVAS OPÇÕES DE FILTRAGEM -->
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <ComboBox x:Name="cbViewTypes" Height="30" VerticalContentAlignment="Center">
                            <ComboBoxItem Content="Todos os Tipos" IsSelected="True"/>
                            <ComboBoxItem Content="Notas de Texto"/>
                            <ComboBoxItem Content="Plantas 2D"/>
                            <ComboBoxItem Content="Vistas 3D"/>
                            <ComboBoxItem Content="Outras Vistas (Cortes, Elevações)"/>
                            <ComboBoxItem Content="Tabelas"/>
                            <ComboBoxItem Content="Folhas"/>
                        </ComboBox>
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="btnSelectAll" Content="Selecionar Tudo" Background="Transparent" BorderThickness="0" Foreground="#666" Cursor="Hand" Margin="0,0,15,0"/>
                            <Button x:Name="btnSelectNone" Content="Limpar Seleção" Background="Transparent" BorderThickness="0" Foreground="#666" Cursor="Hand"/>
                        </StackPanel>
                        <TextBlock x:Name="lblSelectedCount" Text="0 filtrados" HorizontalAlignment="Right" Foreground="#999" VerticalAlignment="Center" FontSize="11"/>
                    </Grid>

                    <ListBox x:Name="lbViews" Grid.Row="3" BorderBrush="#E5E5E5" BorderThickness="1" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected}" Margin="5,5" VerticalContentAlignment="Center" Click="AoClicarCheckbox">
                                    <StackPanel Margin="5,0,0,0">
                                        <TextBlock Text="{Binding ViewName}" FontSize="12" Foreground="#333"/>
                                        <TextBlock Text="{Binding ViewType}" FontSize="10" Foreground="#999" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </CheckBox>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- COLUNA DIREITA: Pré-visualização -->
            <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="15" Margin="7,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,15">
                        <TextBlock Text="2. PRÉ-VISUALIZAÇÃO" FontWeight="Bold" FontSize="12" Foreground="#333"/>
                        <TextBlock x:Name="lblPreviewCount" Text="0 correspondências" HorizontalAlignment="Right" Foreground="#999" FontSize="11"/>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="NOME ATUAL" FontSize="11" FontWeight="Bold" Foreground="#999"/>
                        <TextBlock Grid.Column="1" Text="NOVO NOME" FontSize="11" FontWeight="Bold" Foreground="#999"/>
                    </Grid>

                    <ListBox x:Name="lbPreview" Grid.Row="2" BorderBrush="#E5E5E5" BorderThickness="1" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="5,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding CurrentName}" Foreground="#555" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="1" Text=" ➔ " Foreground="#CCC" Margin="10,0"/>
                                    <TextBlock Grid.Column="2" Text="{Binding NewName}" Foreground="#2B6EEA" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <!-- RODAPÉ: Botões -->
        <Grid Grid.Row="2" Margin="0,15,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="btnCancel" Content="Cancelar" Background="Transparent" BorderThickness="0" Foreground="#555" Width="80" Height="35" Margin="0,0,10,0" Cursor="Hand"/>
                <Button x:Name="btnRename" Content="Renomear Vistas" Background="#2B6EEA" Foreground="White" BorderThickness="0" Width="140" Height="35" Cursor="Hand" FontWeight="SemiBold">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>